# Normaliza los finales de línea a LF en el repositorio, independientemente
# de la plataforma/checkout (evita que git convierta a CRLF en Windows).
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
